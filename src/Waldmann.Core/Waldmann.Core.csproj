<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain model, input rules, ports and use cases. netstandard2.0 so that the Xamarin heads can
       consume it; no package references besides compile-time polyfills. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Waldmann.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
