<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adapters for the ports of Waldmann.Core. There is no server yet: everything is in memory and
       seeded with the content of the legacy prototype (see docs/ARCHITECTURE.md, ADR 4). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Waldmann.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Waldmann.Core\Waldmann.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="PolySharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Waldmann.Infrastructure.Tests" />
  </ItemGroup>

</Project>
