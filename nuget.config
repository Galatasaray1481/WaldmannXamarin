<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org. Machine-wide feeds (company feeds, caches) must not influence what this
     repository restores — local builds and GitHub Actions resolve exactly the same packages. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
